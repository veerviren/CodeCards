<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/friend_detail"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="@color/cardview_dark_background"
    android:weightSum="10">

    <ImageView
        android:id="@+id/friend_avator"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="5dp"
        android:src="@drawable/my_pic" />

    <TextView
        android:id="@+id/friend_handle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Friend1"
        android:textSize="20sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="center"
        android:layout_weight="5"
        android:layout_gravity="center_vertical"
        android:textColor="@color/cardview_light_background"
        tools:ignore="RtlCompat" />

    <TextView
        android:id="@+id/friend_rating"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1000"
        android:textSize="20sp"
        android:textAlignment="center"
        android:layout_weight="4"
        android:layout_gravity="center_vertical"
        android:textColor="@color/cardview_light_background"
        tools:ignore="RtlCompat" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/delete_friend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="Remove"
        android:textColor="@color/cardview_dark_background"
        android:backgroundTint="@color/cardview_light_background"
        android:drawableLeft="@drawable/baseline_delete_forever_24"
        android:layout_gravity="center_vertical" />

</LinearLayout>
