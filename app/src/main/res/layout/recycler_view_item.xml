<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/friend_detail"
    android:layout_width="match_parent"
    android:padding="8dp"
    android:weightSum="10"
    android:background="@color/cardview_dark_background"
    android:layout_height="70dp">
    <ImageView
        android:id="@+id/friend_avator"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:src="@drawable/my_pic" />

    <TextView
        android:id="@+id/friend_handle"
        android:textAlignment="center"
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:textColor="@color/cardview_light_background"
        android:layout_height="wrap_content"
        android:layout_weight="6"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="25sp"
        android:text="Friend1"
        tools:ignore="RtlCompat">

    </TextView>

    <TextView
        android:id="@+id/friend_rating"
        android:layout_width="0dp"
        android:textColor="@color/cardview_light_background"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:layout_gravity="center_vertical"
        android:textAlignment="center"
        android:textSize="25sp"
        android:text="1000"
        tools:ignore="RtlCompat">
    </TextView>

    <Button
        android:id="@+id/delete_friend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@color/cardview_light_background"
        android:drawableLeft="@drawable/baseline_delete_forever_24"
        android:text="Delete"
        android:padding="6dp"
        android:minHeight="0dp"
        android:minWidth="0dp">
    </Button>

</LinearLayout>